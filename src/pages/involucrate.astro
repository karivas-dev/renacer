---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import DSC01769 from "@assets/engage/DSC01769.jpg";
import DSC01793 from "@assets/engage/DSC01793.jpg";
import Footer from "../components/Footer.astro";
---

<Layout>
  <div class="relative mx-24 grid h-[calc(100vh-138px)] grid-cols-5">
    <Image src={DSC01769} alt="Foto grupal" class="col-span-4 col-end-5 my-auto rounded-xl" layout="full-width" />

    <div class="bg-r-gray-800 absolute right-0 bottom-0 w-1/2 -translate-y-1/2 space-y-4 rounded-xl p-6">
      <h1 class="text-3xl font-bold">¿Cómo puedo ayudar?</h1>
      <p>
        En Fundación Renacer creemos que cada aporte cuenta y transforma vidas. Hoy puedes ser parte de nuestra misión,
        apoyando a jóvenes en su proceso de crecimiento personal, y en la construcción de un futuro con más
        oportunidades.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-8">
    <Image src={DSC01793} class="col-span-3" alt="Foto grupal" />

    <div class="col-span-5 grid grid-rows-2">
      <div class="bg-r-green flex flex-col justify-items-center space-y-2 px-8 py-6 text-white">
        <h1 class="text-2xl font-bold">Ser voluntario</h1>
        <p class="text-lg">Aportando tu tiempo, talento y compromiso para acompañar a quienes más lo necesitan.</p>
      </div>

      <div class="bg-r-gray-800 px-8 py-6">
        <h1 class="text-2xl font-bold">Donar como persona natural</h1>
        <p>Realizando donaciones que contribuyen directamente al desarrollo de nuestros programas.</p>
      </div>
    </div>
  </div>

  <Footer />
</Layout>
