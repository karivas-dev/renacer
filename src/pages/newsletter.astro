---
import Layout from "../layouts/Layout.astro";
const pdfs = Object.values(import.meta.glob('../../public/newsletter/*.pdf', {eager: true})).map((pdf: any) => pdf.default.replace('/public', ''));
---

<Layout>
    <div class="mx-6 md:mx-28">
        {pdfs.map((pdf) => (
            <div class="h-[80vh] md:h-[calc(100vh-138px)] rounded-xl overflow-hidden shadow-lg border border-gray-200">
                <embed
                        src={pdf+'#toolbar=0&scrollbar=0&view=FitV'}
                        type="application/pdf"
                        class="w-full h-[calc(100vh-138px)]"
                />
            </div>

            <hr class="bg-r-gray-900 my-12 h-px border-0 mx-12" />
        ))}
    </div>
</Layout>