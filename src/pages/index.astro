---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import {
  Medal,
  HeartHandshake,
  Scale,
  Sprout,
  Shapes,
  SquaresIntersect,
  GraduationCap,
  BriefcaseBusiness,
  Handshake,
} from "@lucide/astro";
import homepagePasantia from "@assets/home/homepage-pasantia.jpg";
import homepagePatrocinio from "@assets/home/homepage-patrocinio.jpeg";
import homepageEmpleo from "@assets/home/homepage-empleo.jpg";
import banner from "@assets/home/DSC07345.jpg";
import concierto from "@assets/home/Rock con propósito.png"
import renacerConecta from "@assets/home/Renacer-Conecta 2026.png"
import groupClass from "@assets/home/group-class.jpg";
import groupEvent from "@assets/home/DSC07175.jpg";
import entreAmigas from "@assets/home/Entre amigas.png"
import carrera from "@assets/home/Carrera Se Vale Soñar.png"
import Card from "../components/Card.astro";
import SecondaryButton from "../components/SecondaryButton.astro";
import Footer from "../components/Footer.astro";
import Banner from "../components/Banner.astro";
import Link from "../components/Link.astro";

const partners = Object.values(import.meta.glob('../assets/home/logos/*.{jpg,png,webp}', {eager: true})).map((img: any) => img.default);

const bannerItems = [
  {
    img: banner,
    title: '¿Quiénes <span class="text-r-green">somos?</span>',
    firstText:
      "Somos una organización sin fines de lucro en El Salvador que acompaña a jóvenes en situación de vulnerabilidad, especialmente a quienes provienen de casas hogares, brindándoles formación integral a través de nuestro programa Creando Esperanza.",
    secondText:
      "Mediante capacitación técnica, desarrollo de habilidades para la vida, acompañamiento psicológico y vinculación con empresas aliadas, impulsamos la inserción laboral y la construcción de proyectos de vida dignos, promoviendo oportunidades reales para desarrollo personal y profesional de nuestros jóvenes.",
  },
  {
    img: renacerConecta,
    title: 'Renacer <span class="text-r-green">conecta 2026</span>',
    firstText:"El pasado 30 de abril realizamos nuestro evento intersedes, donde 120 jóvenes de San Salvador y Santa Ana se reunieron en una jornada al aire libre llena de energía, aprendizaje y conexión.",
  },
  {
    img: concierto,
    title: 'Concierto de <span class="text-r-green">Rock 2025</span>',
    firstText: "En agosto 2025, se llevó a cabo el primer concierto de Rock a beneficio de Fundación Renacer. La música y el talento estuvieron a cargo de Prueba de Sonido y Little Bird Bone, dos bandas salvadoreñas que se sumaron a esta oportunidad única para unir a la comunidad en torno a una causa noble y transformadora.",
  },
  {
    img: carrera,
    title: 'Carrera <span class="text-r-green">Se Vale Soñar</span>',
    firstText: "La primera carrera desarrollada para seguir impulsando el futuro de 120 jóvenes, recibió un fuerte respaldo por parte de las personas en general, la comunidad runner y las empresas. Reafirmando el compromiso que se tiene con los jóvenes y la motivación de construir futuros llenos de posibilidades.",
  },
  {
    img: entreAmigas,
    title: 'Entre amigas'
  },
];
---

<Layout position="fixed">
  <swiper-container slides-per-view="1" autoplay="true" autoplay-delay="9000" loop="true" css-mode="true" allowSlideNext="true" allowSlidePrev="true">
    {
      bannerItems.map((item) => (
        <swiper-slide class="my-auto">
          <Banner img={item.img} firstText={item.firstText} secondText={item.secondText} title={item.title}/>
        </swiper-slide>
      ))
    }
  </swiper-container>
  <main>
    <section class="mx-6 md:mx-20 my-32 grid gap-12 md:grid-cols-2" id="como-impactamos">
      <Image src={groupClass} class="order-2 rounded-2xl" alt="Foto grupal" layout="constrained" format="jpeg" />
      <div class="order-1 my-auto">
        <h1 class="mb-4 text-3xl font-bold md:mb-8 md:text-4xl">
          ¿Cómo cambiamos <span class="text-r-green">vidas?</span>
        </h1>
        <p class="flex flex-col space-y-2">
          Desde el 2014, el programa Creando Esperanza acompaña a
          jóvenes que, al cumplir 18 años, deben abandonar las casas de
          acogida y enfrentar la vida sin una red de apoyo, cargando con
          carencias económicas y afectivas. También brinda
          oportunidades a quienes, entre los 17 y 21 años, viven en
          circunstancias de vulnerabilidad y anhelan una oportunidad
          para salir adelante.
        </p>

        <div class="mt-10 flex flex-col space-y-3 md:flex-row md:space-y-0 md:space-x-4">
          <Link href="/sobre-nosotros#nuestro-impacto" class="border-r-green bg-r-green grow rounded-xl border px-6 py-4 text-center text-white hover:text-r-green hover:bg-transparent"
            >Nuestro impacto</Link
          >

          <SecondaryButton route="/creando-esperanza" text="Creando Esperanza" />
        </div>
      </div>
    </section>

    <section class="mx-6 md:mx-20 my-32 text-center" id="nuestros-valores">
      <h1 class="mb-4 text-3xl font-bold md:mb-8 md:text-4xl">
        Nuestros <span class="text-r-green">valores</span>
      </h1>
      <p class="mb-16">Los principios que guían cada acción y decisión en nuestro compromiso con la juventud.</p>

      <div class="grid grid-cols-2 gap-y-12 text-xl *:space-y-4 md:grid-cols-7 md:*:col-span-2">
        <div>
          <Medal class="mx-auto h-12 w-12" />
          <h2>Excelencia</h2>
        </div>

        <div>
          <SquaresIntersect class="mx-auto h-12 w-12" />
          <h2>Transparencia</h2>
        </div>

        <div>
          <Sprout class="mx-auto h-12 w-12" />
          <h2>Resilencia</h2>
        </div>

        <div class="md:col-start-2!">
          <HeartHandshake class="mx-auto h-12 w-12" />
          <h2>Solidaridad</h2>
        </div>

        <div>
          <Scale class="mx-auto h-12 w-12" />
          <h2>Integridad</h2>
        </div>

        <div>
          <Shapes class="mx-auto h-12 w-12" />
          <h2>Inclusión</h2>
        </div>
      </div>
    </section>

    <section class="mx-6 md:mx-20 my-32" id="transformamos-vidas">
      <h1 class="mb-4 text-3xl font-bold md:mb-8 md:text-4xl">
        Transformamos <span class="text-r-green">vidas</span>
      </h1>
      <p class="md:w-3/4">
        A través del patrocinio, las pasantías y el acceso al empleo, abrimos caminos para que muchos jóvenes
        desarrollen su talento, fortalezcan su futuro y transformen su vida con dignidad y propósito.
      </p>

      <swiper-container class="mt-8 lg:hidden"
                        speed="500"
                        loop="true"
                        css-mode="true"
                        autoplay
                        navigation="true">
        <swiper-slide>
          <Card
              title="Patrocinio"
              description="Gracias al apoyo de nuestras empresas aliadas, los jóvenes reciben formación en empleabilidad, acompañamiento psicológico y talleres de desarrollo personal y profesional."
              image={homepagePatrocinio}
              icon={Handshake}
          />
        </swiper-slide>
        <swiper-slide>
          <Card
              title="Pasantías"
              description="Las empresas aliadas brindan espacios donde los jóvenes fortalecen habilidades técnicas, adquieren experiencia y ganan confianza para su futuro laboral. "
              image={homepagePasantia}
              icon={GraduationCap}
          />
        </swiper-slide>

        <swiper-slide>
          <Card
              title="Empleo"
              description="Los jóvenes de Fundación Renacer acceden a oportunidades laborales y crecimiento profesional junto a nuestras empresas aliadas. "
              image={homepageEmpleo}
              icon={BriefcaseBusiness}
          />
        </swiper-slide>
      </swiper-container>

      <div class="mt-8 auto-rows-min gap-6 md:mt-16 md:gap-8 lg:grid-cols-3 hidden lg:grid">
        <Card
          title="Patrocinio"
          description="Gracias al apoyo de nuestras empresas aliadas, los jóvenes reciben formación en empleabilidad, acompañamiento psicológico y talleres de desarrollo personal y profesional."
          image={homepagePatrocinio}
          icon={Handshake}
        />

        <Card
          title="Pasantías"
          description="Las empresas aliadas brindan espacios donde los jóvenes fortalecen habilidades técnicas, adquieren experiencia y ganan confianza para su futuro laboral. "
          image={homepagePasantia}
          icon={GraduationCap}
        />

        <Card
          title="Empleo"
          description="Los jóvenes de Fundación Renacer acceden a oportunidades laborales y crecimiento profesional junto a nuestras empresas aliadas. "
          image={homepageEmpleo}
          icon={BriefcaseBusiness}
        />
      </div>
    </section>

    <section class="mx-6 md:mx-20 my-32 grid gap-12 md:grid-cols-2" id="conoce-nuestro-impacto">
      <Image src={groupEvent} class="order-2 rounded-2xl" alt="Fotografía grupal" layout="constrained" format="jpeg" />
      <div class="order-1 my-auto">
        <h1 class="mb-4 text-3xl font-bold md:mb-8 md:text-4xl">
          Nuestro <span class="text-r-green">impacto</span>
        </h1>
        <p class="mb-10">
          Se refleja en oportunidades que se convierten en resultados. A lo largo de los años, Fundación Renacer ha
          acompañado a cientos de jóvenes en su formación académica y su inserción laboral, generando mejoras reales en
          su calidad de vida y fortaleciendo su proyección profesional.
        </p>

        <SecondaryButton route="/sobre-nosotros" text="Conoce nuestro impacto" />
      </div>
    </section>

    <section class="px-6 md:px-20 py-32 bg-white" id="aliados">
      <h1 class="mb-6 text-3xl font-bold md:mb-8 md:text-4xl">
        Nuestros <span class="text-r-green">aliados</span>
      </h1>

      <swiper-container
        class="overflow-visible space-x-2"
        speed="500"
        loop="true"
        css-mode="true"
        autoplay
        navigation="true"
        breakpoints='{
                        "320": {
                            "slidesPerView": 3
                        },
                        "640": {
                            "slidesPerView": 4
                        },
                        "768": {
                            "slidesPerView": 5
                        },
                        "1024": {
                            "slidesPerView": 7
                        }
					}'
      >
        {
          partners.map((partner) => (
            <swiper-slide class="my-auto">
              <Image src={partner} alt="Logo" layout="fixed" class="h-auto w-40" width="120" />
            </swiper-slide>
          ))
        }
      </swiper-container>
    </section>
  </main>

  <Footer />
</Layout>
