---
import Link from "./Link.astro";
const { route, text, class: className, primary = true } = Astro.props;
import { twMerge } from "tailwind-merge";
---

<Link
  href={route}
  class={twMerge(
    `grow rounded-xl border px-6 py-4 text-center block
  ${primary ? "text-white bg-r-green hover:text-r-green hover:bg-transparent hover:border-r-green" : "border-r-green text-r-green hover:bg-r-green hover:text-white"}`,
    className,
  )}>{text}</Link
>
