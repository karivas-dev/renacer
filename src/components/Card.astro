---
import { Image } from "astro:assets";

const { title, description, image, icon: Icon } = Astro.props;
---

<div
  class="even:bg-r-green group flex flex-col justify-end rounded-xl p-4 lg:shadow-2xl odd:bg-white even:text-white md:p-6"
>
  <div class="space-y-4 group-odd:mb-4 group-even:order-last group-even:mt-4 md:group-odd:mb-8 md:group-even:mt-8">
    <div class="ml-2 flex items-center space-x-4 text-2xl font-bold md:text-3xl">
      {Icon && <Icon class="group-odd:bg-r-green/25 text-r-green h-12 w-12 rounded-lg p-2 group-even:bg-[#d4eadc]" />}
      <span class="font-source-sans">{title}</span>
    </div>
    <p>{description}</p>
  </div>

  <Image
    src={image}
    class="h-95 rounded-xl object-cover group-even:order-first"
    alt={`${title} image`}
    layout="constrained"
    format="jpeg"
  />
</div>
