---
import {twMerge} from "tailwind-merge";

const { href, class: className } = Astro.props;

const clean = (path) => path.replace(/\/$/, "") || "/";

const basePath = clean(import.meta.env.BASE_URL);
const currentPath = clean(Astro.url.pathname);
const finalHref = clean(`${basePath === "/" ? "" : basePath}${href}`);

const isActive = (string) => currentPath === finalHref ? string : null;
---

<a href={finalHref} class={twMerge('hover:text-r-green', isActive('text-r-green font-bold'), className)} data-astro-prefetch>
    <slot/>
</a>