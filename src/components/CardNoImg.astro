---
import { Wrench } from "@lucide/astro";

const { title, description, icon: Icon } = Astro.props;
---

<div class="bg-r-gray-800 space-y-4 rounded-xl p-4 lg:p-6">
  <div class="bg-r-green/25 w-fit rounded-lg p-3">
    {Icon && <Icon class="text-r-green h-8 w-8" />}
  </div>
  <h1 class="text-xl font-bold lg:text-2xl">{title}</h1>
  <p>{description}</p>
</div>
