---
import {Wrench} from "@lucide/astro";

const {title, description, icon: Icon} = Astro.props;
---

<div class="bg-r-gray-800 p-6 rounded-xl space-y-4">
    <div class="bg-r-green/25 w-fit p-3 rounded-lg">
        {Icon && <Icon class="h-8 w-8 text-r-green"/>}
    </div>
    <h1 class="text-2xl font-bold">{ title }</h1>
    <p>{ description }</p>
</div>
