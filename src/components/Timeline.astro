---
const timeline = [
  {
    year: "2013",
    text: `
        En octubre de 2013 Don Ricardo Poma,
        junto a su hijo Fernando, establece
        Fundación Renacer y lanza el
        programa Creando Esperanza para
        apoyar a la niñez y juventud
        salvadoreña en situación de
        vulnerabilidad.
        `,
  },

  {
    year: "2014",
    text: `
        Se comienza el trabajo con hogares de distintos municipios del país para identificar y perfilar a los jóvenes
        participantes de Creando Esperanza.
        `,
  },

  {
    year: "2015",
    text: `
        Los jóvenes de Creando Esperanza se
capacitan en áreas de hotelería en el
Hotel Real InterContinental y reciben
clases de inglés para fortalecer su
empleabilidad.
        `,
  },
  {
    year: "2016",
    text: `Creando Esperanza comienza con 25 jóvenes de cinco hogares, quienes
        realizan sus prácticas profesionales en el Hotel Real InterContinental San Salvador.`,
  },
  {
    year: "2017",
    text: `1.ª generación: Se gradúan 17 jóvenes;
el 94% obtiene empleo y el 6% continúa
estudios superiores.
2.ª  generación: Inicia con 31 jóvenes de
siete casas hogar y se amplía a siete
empresas de Grupo Poma para prácticas
profesionales.`,
  },
  {
    year: "2018",
    text: `2.ª generación: Se gradúan 31 jóvenes,
con 100% de empleabilidad.
3.ª  generación: Inicia la preparación de
60 jóvenes de 16 casas hogar, con el
apoyo de nueve empresas aliadas.`,
  },
  {
    year: "2019",
    text: `Se construye el centro de cómputo para
impartir informática y obtener la
certificación MOS de Microsoft.
3.ª generación: Se gradúan 58 jóvenes;
88% obtiene un empleo y 12% continúa
estudios superiores.
4.ª generación: Inicia con 70 jóvenes de
12 hogares.`,
  },
  {
    year: "2020",
    text: `Se lanza “Salud Mental en Tiempos de
COVID-19”, beneficiando a más de 50
instituciones 
con conferencias y
consejería psicológica gratuita, además
de 
brindar 
acompañamiento
emocional continuo a jóvenes de
Creando Esperanza.`,
  },
  {
    year: "2021",
    text: `Los jóvenes participan en conversatorios
virtuales semanales sobre valores,
empleabilidad y salud mental.
El programa “Salud Mental en Tiempos
de COVID-19” continúa activo y amplía su
alcance y temáticas.`,
  },
  {
    year: "2022",
    text: `Se gradúa la 5ª generación, integrada
por 58 jóvenes de 10 casas hogar con
apoyo de 17 empresas aliadas.
Se inicia el reclutamiento de una nueva
generación con la meta de beneficiar a
90 jóvenes del área paracentral,
ampliando el alcance del programa.`,
  },
  {
    year: "2023",
    text: `El equipo de psicología se capacita en
terapia EMDR (Sanación de traumas
mediante Estimulación bilateral del
cerebro) y se inauguran nuevas
instalaciones para atención terapéutica.
6.ª generación: se gradúan 92 jóvenes,
fortaleciendo el impacto del programa.`,
  },
  {
    year: "2024",
    text: `Se realizan visitas diagnósticas a
hogares infantiles a nivel nacional y se
inician acercamientos con CONAPINA y
otras organizaciones para ampliar el
programa.
7.ª generación: Se gradúan 85 jóvenes
tras recibir formación técnica, talleres
de habilidades y acompañamiento
psicológico.`,
  },
  {
    year: "2025",
    text:
      "8.ª generación integra a 78 jóvenes que\n" +
      "culminan su formación integral.\n" +
      "Se inaugura nueva sede en Santa Ana y\n" +
      "se implementa el programa de\n" +
      "voluntariado para fortalecer y visibilizar\n" +
      "el impacto de Fundación Renacer",
  },
];
---

<section class="relative overflow-hidden">
  <!-- Desktop line -->
  <div class="bg-r-gray-900/20 absolute top-52 bottom-92 left-1/2 hidden w-px -translate-x-1/2 md:block"></div>

  <!-- Mobile line -->
  <div class="bg-r-gray-900/20 absolute top-20 bottom-20 left-6 w-px md:hidden"></div>

  <div class="mx-auto max-w-6xl px-4 py-20 md:py-40">
    {
      timeline.map((item, index) => (
        <article class="timeline-item relative mb-16 grid grid-cols-1 gap-6 md:mb-28 md:grid-cols-2 md:gap-20">
          {/* Desktop dot */}
          <div class="timeline-dot bg-r-green absolute top-10 left-1/2 z-20 hidden h-5 w-5 -translate-x-1/2 rounded-full border-4 border-[#f8f7f4] shadow-md md:block" />

          {/* Mobile dot */}
          <div class="timeline-dot bg-r-green absolute top-5 left-6 z-20 h-4 w-4 -translate-x-1/2 rounded-full border-4 border-[#f8f7f4] shadow-md md:hidden" />

          {/* YEAR */}
          <div
            class={`pl-14 md:pl-0 ${
              index % 2 === 0 ? "md:text-right" : "md:order-2"
            } sticky top-8 self-start md:top-32`}
          >
            <h2 class="year text-r-green text-4xl font-black tracking-tight md:text-7xl">{item.year}</h2>
          </div>

          {/* CARD */}
          <div class={`pl-14 md:pl-0 ${index % 2 === 0 ? "" : "md:order-1 md:text-right"}`}>
            <div class="card relative z-10 rounded-xl border border-zinc-200 bg-white p-5 shadow-[0_10px_40px_rgba(0,0,0,0.04)] md:p-6">
              <p class="leading-relaxed">{item.text}</p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener("load", () => {
    gsap.registerPlugin(ScrollTrigger);

    gsap.utils.toArray(".card").forEach((card, index) => {
      gsap.from(card as HTMLElement, {
        opacity: 0,
        y: 80,
        x: index % 2 === 0 ? -40 : 40,
        duration: 1.2,
        ease: "power3.out",

        scrollTrigger: {
          trigger: card,
          start: "top 85%",
          end: "top 60%",
          scrub: 1,
        },
      });
    });

    // YEAR ANIMATIONS
    gsap.utils.toArray(".year").forEach((year) => {
      gsap.from(year as HTMLElement, {
        opacity: 0,
        y: 40,
        scale: 0.9,
        duration: 1,

        scrollTrigger: {
          trigger: year,
          start: "top 90%",
          end: "top 70%",
          scrub: 1,
        },
      });
    });

    gsap.utils.toArray(".timeline-dot").forEach((dot) => {
      gsap.from(dot as HTMLElement, {
        scale: 0,
        opacity: 0,
        duration: 0.6,
        ease: "back.out(1.7)",

        scrollTrigger: {
          trigger: dot,
          start: "top 85%",
        },
      });
    });
  });
</script>
