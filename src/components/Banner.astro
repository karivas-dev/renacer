---
import { Image } from "astro:assets";

const { img, firstText, secondText, title } = Astro.props;
---

<div class="relative h-screen w-full overflow-hidden pb-50 md:pb-0" id="quienes-somos">
  <Image
    src={img}
    class="h-screen min-w-screen object-cover"
    alt="Fundación Renacer banner"
    layout="full-width"
    sizes="(orientation: portrait) 100vh, 100vw"
    quality={100}
    format="jpeg"
  />
  <div
    class="absolute mx-2 flex flex-col justify-end rounded-t-2xl bg-black/35 p-6 text-white backdrop-blur-sm backdrop-saturate-100 bottom-0"
  >
    <h1 class="mb-4 text-4xl font-bold text-shadow-lg" set:html={title} />

    <p class="flex flex-col text-lg">
      <span>
        {firstText}
      </span>

      <span class="hidden pt-4 md:block md:pt-0">
        {secondText}
      </span>
    </p>
  </div>
</div>
