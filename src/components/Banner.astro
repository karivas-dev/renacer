---
import banner from "@assets/home/DSC07345.jpg";
import { Image } from "astro:assets";

const { firstText, secondText } = Astro.props;
---

<div class="relative h-screen w-full" id="quienes-somos">
  <Image src={banner} class="h-screen object-cover" alt="Foto grupal" layout="full-width" format="jpeg" />
  <div class="absolute bottom-0 flex h-5/10 flex-col justify-end bg-linear-to-t from-neutral-950 p-6 text-white">
    <h1 class="mb-8 text-4xl font-bold">
      ¿Quiénes <span class="text-r-green">somos?</span>
    </h1>
    <p class="flex flex-col text-lg md:w-5/6">
      <span>
        {firstText}
      </span>

      <span class="pt-4">
        {secondText}
      </span>
    </p>
  </div>
</div>
