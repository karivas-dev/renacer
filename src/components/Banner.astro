---

import banner from "@assets/home/DSC07345.jpg";
import {Image} from "astro:assets";

const { firstText, secondText } = Astro.props;
---

<div class="relative w-full h-screen" id="quienes-somos">
    <Image src={banner} class="h-screen object-cover" alt="Foto grupal" layout='full-width' format='jpeg'/>
    <div class="absolute bottom-0 text-white p-6 bg-linear-to-t from-neutral-950 h-5/10 flex flex-col justify-end">
        <h1 class="text-4xl font-bold mb-8">¿Quiénes <span class="text-r-green">somos?</span></h1>
        <p class="md:w-5/6 text-lg flex flex-col">
				<span>
					{ firstText }
				</span>

            <span class="pt-4">
					{ secondText }
				</span>
        </p>
    </div>
</div>