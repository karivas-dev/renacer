---
import Link from "./Link.astro";
import Logo from "@assets/home/Logo-Renacer-SF.png";
import { Menu, X } from "@lucide/astro";
import { Image } from "astro:assets";

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/sobre-nosotros", label: "Sobre nosotros" },
  { href: "/creando-esperanza", label: "Creando Esperanza" },
  { href: "/involucrate", label: "Involúcrate" },
];
---

<header id="nav" class="max-w-full rounded-lg bg-white px-6 py-4 shadow-xl" data-state="closed">
  <div class="flex items-center justify-between">
    <Link href="/" class="shrink-0">
      <Image alt="Fundación Renacer logo" src={Logo} width="125" layout="fixed" />
    </Link>

    <nav class="hidden items-center space-x-6 md:flex">
      {
        navLinks.map((link) => (
          <Link href={link.href} class="transition-all duration-200 hover:opacity-70">
            {link.label}
          </Link>
        ))
      }
      <Link href='' class="transition-all duration-200 hover:opacity-70 hover:text-white bg-r-green px-8 py-3 rounded-full text-white font-bold">
        Donar
      </Link>
    </nav>

    <button class="md:hidden" aria-label="Toggle menu" aria-controls="mobileMenu" aria-expanded="false" type="button" data-nav-toggle>
      <Menu class="open:hidden" size={28} />
      <X class="closed:hidden" size={28} />
    </button>
  </div>

  <div class="h-0 overflow-hidden md:hidden" id="mobileMenu" aria-hidden="true">
    <nav class="mt-4 flex flex-col space-y-4 border-t border-r-gray-800 pt-4">
      {
        navLinks.map((link) => (
          <Link href={link.href} data-nav-toggle class="hover:opacity-70">
            {link.label}
          </Link>
        ))
      }

      <Link href='' class="transition-all duration-200 hover:opacity-70 hover:text-white bg-r-green px-8 py-3 rounded-full text-white font-bold text-center">
        Donar
      </Link>
    </nav>
  </div>
</header>

<script>
  import gsap from "gsap";

  const header = document.querySelector("#nav");
  const toggleButtons = document.querySelectorAll("[data-nav-toggle]");
  const toggleButton = document.querySelector("button[data-nav-toggle]");
  const mobileMenu = document.querySelector("#mobileMenu");
  const mobileLinks = mobileMenu?.querySelectorAll("a");

  toggleButtons.forEach((toggleButton) => toggleButton.addEventListener("click", toggleNav));

  function toggleNav() {
    const isOpen = header?.getAttribute("data-state") === "open";

    header?.setAttribute("data-state", isOpen ? "closed" : "open");
    toggleButton?.setAttribute("aria-expanded", isOpen ? "false" : "true");
    mobileMenu?.setAttribute("aria-hidden", isOpen ? "true" : "false");

    if (!isOpen) {
      gsap.fromTo(
        mobileMenu,
        { height: 0, opacity: 0 },
        { height: "auto", opacity: 1, duration: 0.35, ease: "power2.out" },
      );

      if (mobileLinks) {
        gsap.fromTo(
          mobileLinks,
          { y: -10, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            stagger: 0.06,
            duration: 0.25,
            delay: 0.1,
            ease: "power2.out",
          },
        );
      }
    } else {
      gsap.to(mobileMenu, {
        height: 0,
        opacity: 0,
        duration: 0.25,
        ease: "power2.inOut",
      });
    }
  }
</script>
